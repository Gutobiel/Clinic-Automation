# ==============================================================================
# Template de Credenciais — Clínica Nova Gesta (COPIAR PARA .env APENAS NA VPS)
# NUNCA commitar o arquivo .env real no Git!
# ==============================================================================

TENANT_SLUG=nova-gesta
AUTOMATION_MODE=SHADOW   # SHADOW | ASSISTED | AUTONOMOUS

# --- Webhook / Ponte com AGS CRM ---
CRM_WEBHOOK_API_KEY=trocar-por-chave-forte
CRM_CALLBACK_URL=https://api.aegiscrm.com.br/api/integrations/clinic-automation/callback

# --- API iGUT (Leitura de Agenda) + iGUT Web (Fechamento Guias/Arquivos) ---
IGUT_CLIENT_NAME=novagesta
IGUT_API_USER=
IGUT_API_PASS=
IGUT_WEB_URL=https://novagesta.igutclinicas.com.br
IGUT_WEB_USER=
IGUT_WEB_PASS=

# --- Google Drive (Dossiê Compartilhado por Paciente) ---
GOOGLE_DRIVE_AUTH_MODE=service_account   # service_account | oauth2
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_DRIVE_SERVICE_ACCOUNT_PATH=/opt/clinic-automation/secrets/google-sa.json
# Caso oauth2:
GOOGLE_DRIVE_OAUTH_CLIENT_ID=
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=
GOOGLE_DRIVE_OAUTH_REFRESH_TOKEN=

# --- LLM Multimodal (Auditor Anti-Glosa) ---
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Portais de Convênios (Preencher somente na VPS com chmod 600) ---
AMHP_PORTAL_URL=https://portal.amhp.com.br/
AMHP_PORTAL_USER=
AMHP_PORTAL_PASS=

GDF_SAUDE_USER=
GDF_SAUDE_PASS=

POSTAL_SAUDE_USER=
POSTAL_SAUDE_PASS=

PLAN_ASSISTE_USER=
PLAN_ASSISTE_PASS=

SAUDE_CAIXA_USER=
SAUDE_CAIXA_PASS=

BENNER_CONECTA_USER=
BENNER_CONECTA_PASS=

PROSAUDE_TJDFT_USER=
PROSAUDE_TJDFT_PASS=

AMIL_USER=
AMIL_PASS=

PF_SAUDE_USER=
PF_SAUDE_PASS=

TST_SAUDE_USER=
TST_SAUDE_PASS=
